# ElevenLabs API Key (for ElevenLabs Scribe v2)
ELEVENLABS_API_KEY=REPLACE_ME_WITH_ELEVENLABS_KEY

# STT Engine Configuration
# Available engines: elevenlabs, whisper
STT_ENGINES=elevenlabs,whisper

# Whisper Engine Settings (local fallback)
# Use cpu/small/int8 if you have no working NVIDIA GPU. For a GPU use cuda/float16 and a larger model such as large-v3 or medium.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Audio Preprocessing & Chunking
AUDIO_MIN_DURATION_S=2.0
AUDIO_MAX_DURATION_S=10800.0
AUDIO_CHUNK_MAX_S=600.0
AUDIO_CHUNK_OVERLAP_S=1.5
AUDIO_ENABLE_DENOISING=false

# Optional binary paths (defaults to system PATH or auto-detected binaries)
# FFMPEG_PATH=
# FFPROBE_PATH=

# LLM Providers (Verify exact model IDs on the provider's live docs/dashboard)
GROQ_API_KEY=REPLACE_ME_WITH_GROQ_KEY
OPENROUTER_API_KEY=REPLACE_ME_WITH_OPENROUTER_KEY

# Copy exact model IDs from console.groq.com/docs/models and openrouter.ai/models (filter: Free). OpenRouter free models rotate, re-check before demo.
# Example: FALLBACK_MODELS=openrouter:meta-llama/llama-3-8b-instruct:free
LLM1_MODEL=groq:REPLACE_ME
LLM2_MODEL=groq:REPLACE_ME
FALLBACK_MODELS=openrouter:REPLACE_ME,groq:REPLACE_ME
LLM_RATE_LIMIT_RPM=20
